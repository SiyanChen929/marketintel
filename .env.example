# Copy to .env (or export in your shell / launchd environment). Never commit real values.

# --- ai_semi_intel (research pipeline) ---
FRED_API_KEY=                 # free key from https://fred.stlouisfed.org/docs/api/api_key.html
SEC_USER_AGENT="Your Name your.email@example.edu"   # SEC EDGAR fair-access contact string
AI_SEMI_OUTPUTS=              # optional: write products somewhere other than ./outputs
PITCHBOOK_API_KEY=            # optional, licensed; pipeline runs without it
PITCHBOOK_API_BASE=

# --- LLM layer (optional; rules-only classification runs without a key) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MARKET_INTEL_LLM_PROVIDER=    # anthropic | openai (default: whichever key exists)
MARKET_INTEL_MODEL=           # pin a model; empty = provider default
MARKET_INTEL_NO_LLM=          # 1 = force rules-only
MARKET_INTEL_LLM_TOKEN_BUDGET=
MARKET_INTEL_LLM_COST_BUDGET_USD=
MARKET_INTEL_LLM_PRICING_JSON=

# --- market_intel web service ---
MARKET_INTEL_PORT=8787
MARKET_INTEL_ALLOWED_HOSTS=   # extra Host headers when served behind a tunnel
MARKET_INTEL_HOME=            # desktop app only: path to this checkout
